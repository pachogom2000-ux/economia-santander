---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Las secciones salen de collections.secciones con el mismo slugify que usa
    seccion.njk para su permalink, así no se pueden desincronizar.

    Sobre `lastmod`: solo se pone donde es VERIFICABLE. Google dice que usa el
    valor "si es consistente y verificablemente exacto", y que si lo pilla
    mintiendo lo descarta para el sitio entero. Por eso:
      · Notas y portada: la fecha real de publicación o de corrección.
      · Secciones: la fecha de su nota más reciente. Sí cambia cuando entra una.
      · Legales, /quien-soy/, /multimedia/, /indicadores/, /dolar-hoy/: SIN
        lastmod. Poner la fecha del último despliegue sería jurarle a Google
        que la política de cookies cambió siete veces hoy, y con eso se pierde
        la credibilidad del lastmod donde sí sirve. Omitirlo es válido.

    Tampoco van `changefreq` ni `priority`: Google dice textualmente que
    ignora ambos valores. Eran líneas de ruido. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
{%- set ultima = collections.noticias | reverse | first %}
  <url>
    <loc>https://economiasantander.com/</loc>
    <lastmod>{{ ultima.date | fechaModificacionCorta(ultima.data.updated) }}</lastmod>
  </url>
{%- for n in collections.noticias | reverse %}
  <url>
    <loc>https://economiasantander.com{{ n.url }}</loc>
    <lastmod>{{ n.date | fechaModificacionCorta(n.data.updated) }}</lastmod>
  </url>
{%- endfor %}
{#- Cada video, podcast o galería tiene ficha propia desde que dejó de existir
    solo como tarjeta dentro de /multimedia/. Llevan lastmod porque su fecha es
    la de publicación real del contenido. -#}
{%- for m in collections.multimedia | reverse %}
{%- set yid = m.data.youtube | ytId %}
{%- set miniatura = m.data.portada or (("https://i.ytimg.com/vi/" + yid + "/hqdefault.jpg") if yid) %}
  <url>
    <loc>https://economiasantander.com{{ m.url }}</loc>
    <lastmod>{{ m.date | fechaModificacionCorta(m.data.updated) }}</lastmod>
{%- if (m.data.tipo or "video") == "video" and miniatura and (m.data.archivo or yid) %}
    {#- Extensión de video del sitemap. Es lo que le dice a Google que en esta
        página hay un video y de qué va, sin que tenga que deducirlo. Solo se
        emite cuando están los cuatro datos que exige —miniatura, título,
        descripción y una dirección para reproducirlo—; un video a medias no
        se declara, que es la misma regla que se sigue con el lastmod. -#}
    <video:video>
      <video:thumbnail_loc>{% if "//" in miniatura %}{{ miniatura }}{% else %}https://economiasantander.com{{ miniatura }}{% endif %}</video:thumbnail_loc>
      <video:title>{{ m.data.title }}</video:title>
      <video:description>{{ m.data.descripcion or m.data.title }}</video:description>
{%- if m.data.archivo %}
      <video:content_loc>https://economiasantander.com{{ m.data.archivo }}</video:content_loc>
{%- else %}
      <video:player_loc>https://www.youtube-nocookie.com/embed/{{ yid }}</video:player_loc>
{%- endif %}
      <video:publication_date>{{ m.date | isoDate }}</video:publication_date>
    </video:video>
{%- endif %}
  </url>
{%- endfor %}
{%- for s in collections.secciones %}
{%- set fechaSeccion = collections.noticias | ultimaDeSeccion(s.nombre) %}
  <url>
    <loc>https://economiasantander.com/seccion/{{ s.nombre | slugify }}/</loc>
{%- if fechaSeccion %}
    <lastmod>{{ fechaSeccion }}</lastmod>
{%- endif %}
  </url>
{%- endfor %}
{%- for ruta in ["/pico-y-placa/", "/quien-soy/", "/indicadores/", "/dolar-hoy/", "/multimedia/", "/legal/datos-personales/", "/legal/cookies/", "/legal/terminos/", "/legal/politica-editorial/", "/legal/publicidad/"] %}
  <url>
    <loc>https://economiasantander.com{{ ruta }}</loc>
  </url>
{%- endfor %}
</urlset>
