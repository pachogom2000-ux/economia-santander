<script>
  // Muro de logos: se muestran unos pocos a la vez y van alternando —
  // uno entra mientras otro sale, nunca todos al tiempo. Sin JS (o con
  // "reducir movimiento") el muro queda completo y estático, que también
  // le sirve a Google.
  (function () {
    var muro = document.getElementById('qs-muro');
    if (!muro) return;

    var fichas = Array.prototype.slice.call(muro.querySelectorAll('.qs-medio'));
    var datos = fichas.map(function (li) {
      var img = li.querySelector('img');
      return { nombre: li.querySelector('.qs-medio-nombre').textContent, logo: img ? img.getAttribute('src') : '' };
    });

    var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (quieto || datos.length < 7) return;

    var ranuras = window.innerWidth < 700 ? 3 : 5;
    var visibles = datos.slice(0, ranuras);
    var siguiente = ranuras;

    muro.classList.add('rota');
    muro.textContent = '';
    var nodos = visibles.map(function (d) {
      var li = document.createElement('li');
      li.className = 'qs-medio';
      pintar(li, d);
      muro.appendChild(li);
      return li;
    });

    function pintar(li, d) {
      li.innerHTML = '<img src="' + d.logo + '" alt="" width="96" height="96">' +
        '<span class="qs-medio-nombre"></span>';
      li.querySelector('.qs-medio-nombre').textContent = d.nombre;
      li.setAttribute('data-logo', d.logo);
    }

    // El siguiente que no esté ya en pantalla (ni por nombre ni por logo:
    // Semana, Dinero y Finanzas Personales comparten la misma marca).
    function buscarCandidato() {
      for (var i = 0; i < datos.length; i++) {
        var cand = datos[(siguiente + i) % datos.length];
        var repetido = visibles.some(function (v) { return v.nombre === cand.nombre || v.logo === cand.logo; });
        if (!repetido) { siguiente = (siguiente + i + 1) % datos.length; return cand; }
      }
      return null;
    }

    var turno = 0;
    window.setInterval(function () {
      if (document.hidden) return;
      var cand = buscarCandidato();
      if (!cand) return;
      var li = nodos[turno];
      var pos = turno;
      turno = (turno + 1) % nodos.length;

      li.classList.add('saliendo');
      window.setTimeout(function () {
        visibles[pos] = cand;
        pintar(li, cand);
        li.classList.remove('saliendo');
        li.classList.add('entrando');
        window.setTimeout(function () { li.classList.remove('entrando'); }, 400);
      }, 320);
    }, 2000);
  })();
</script>
