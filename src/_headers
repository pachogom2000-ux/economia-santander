# Cabeceras del sitio. Lo entienden IGUAL Netlify y Cloudflare, así que este
# archivo hace que las dos plataformas sirvan el sitio de forma idéntica.
#
# Por qué existe: el HSTS que hoy se envía lo pone la plataforma de Netlify por
# su cuenta, no el repositorio. Al mover el sitio a otro hosting desaparecería
# en silencio. Declarándolo aquí, viaja con el código.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# El HTML nunca se guarda en caché sin revalidar: una nota corregida tiene que
# verse ya. El navegador pregunta y el servidor responde 304 si no cambió.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# La hoja de estilos YA lleva huella (/assets/css/style.<huella>.css), así que
# se congela un año: si el contenido cambia, cambia el nombre y el navegador
# pide el archivo nuevo. Es imposible servir una versión vieja. Esto quita el
# viaje de revalidación que bloqueaba el pintado ~360 ms en CADA visita, aun
# teniendo el archivo ya guardado.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# La copia sin huella se sigue publicando por si quedó HTML viejo cacheado
# apuntando a ella. Esa sí se revalida siempre, que es lo correcto para un
# nombre que no cambia nunca.
/assets/style.css
  Cache-Control: public, max-age=0, must-revalidate

# El comportamiento del sitio YA lleva huella (/assets/js/app.<huella>.js), así
# que se congela un año por la misma razón que el CSS: si cambia el contenido,
# cambia el nombre. Antes vivía en línea dentro del HTML —26 KB que volvían a
# viajar en cada página— y así no había forma de cachearlo.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# El resto del JS todavía no lleva huella: se revalida siempre.
#
# Van nombrados uno por uno A PROPÓSITO. Con el comodín /assets/*.js la regla
# también atrapaba /assets/js/app.<huella>.js, y las dos cabeceras no se
# excluyen: se CONCATENAN. El archivo con huella salió servido con
# "max-age=0, must-revalidate, public, max-age=31536000, immutable", y como el
# max-age=0 va primero, el año de caché no valía nada. Si añades un .js suelto
# en /assets/, agrégalo a esta lista; no vuelvas al comodín.
/assets/app.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/dolar.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/indicadores.js
  Cache-Control: public, max-age=0, must-revalidate

# Las fuentes SÍ llevan huella en el nombre (barlow-400.81419bf5ab.woff2), así
# que se pueden congelar un año: si el archivo cambia, cambia el nombre y el
# navegador pide el nuevo. Sin la huella esto sería la trampa de servir un
# archivo viejo durante un año, que es justo lo que advierten las líneas de
# arriba sobre el CSS.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Las variantes de imagen que genera el build también llevan huella.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Las imágenes y los videos sí se pueden guardar: cuando cambian, cambia el
# nombre del archivo.
/assets/uploads/*
  Cache-Control: public, max-age=604800

/assets/videos/*
  Cache-Control: public, max-age=604800

/assets/logos-medios/*
  Cache-Control: public, max-age=604800

/assets/quien-soy/*
  Cache-Control: public, max-age=604800
