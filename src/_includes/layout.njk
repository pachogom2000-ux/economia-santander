<body>


<div class="pico-ribbon">
  <div class="wrap pico-inner">
    {# Enlaza a la página completa: el dato del encabezado es el gancho y la
       página resuelve las preguntas que la franja no cabe (sábados, motos,
       taxis, excepciones, multa). #}
    <a class="pico-title" href="/pico-y-placa/" title="Ver el pico y placa completo: sábados, motos, taxis y excepciones">Pico y placa</a>
    <div class="pico-cities" id="pico-cities">
      <span class="pico-city"><b>B/manga</b> <span class="pico-digits">—</span></span>
      <span class="pico-city"><b>Bogotá</b> <span class="pico-digits">—</span></span>
      <span class="pico-city"><b>Medellín</b> <span class="pico-digits">—</span></span>
    </div>
  </div>
</div>

<div class="utility-bar">
  <div class="wrap utility-inner">
    <span class="utility-date">
      <svg class="flag-co" viewBox="0 0 6 4" role="img" aria-label="Colombia"><rect width="6" height="2" fill="#FCD116"/><rect y="2" width="6" height="1" fill="#003893"/><rect y="3" width="6" height="1" fill="#CE1126"/></svg>
      <span id="fecha-hoy">—</span>
    </span>
    <a class="dolar-cta" id="trm-live" href="/dolar-hoy/" title="Convertidor de dólares a pesos, puntas de compra y venta y gráfica de la TRM">
      <span class="dot" aria-hidden="true"></span>
      <span>¿Cuánto vale tu dólar?</span>
      <b class="js-usd-entero"></b>
      <span class="flecha" aria-hidden="true">→</span>
    </a>
  </div>
  <div class="ticker-viewport">
    <div class="ticker-track" id="ticker-track">
      <div class="ticker-set">
        {%- for ind in mercado.indicadores %}
        {# La clase del ítem se genera a partir de `vivo`, no con un `if` por
           moneda: así basta con añadir el indicador en mercado.json y darle su
           bloque en el script. Antes solo el dólar tenía gancho. #}
        <a class="ticker-item{% if ind.vivo %} live js-{{ ind.vivo }}-item{% endif %}" href="/indicadores/#{{ ind.id }}" title="{{ ind.title }}{% if ind.vivo or ind.yahoo %} Toca para ver la gráfica.{% else %} Toca para ver el detalle.{% endif %}">
          <span class="name">{{ ind.nombre }}</span>
          <span class="val{% if ind.vivo %} js-{{ ind.vivo }}-val{% endif %}">{{ ind.valor }}</span>
          <span class="delta {{ ind.dir or 'flat' }}{% if ind.vivo %} js-{{ ind.vivo }}-delta{% endif %}">{{ ind.delta }}</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap">
    <p class="kicker">Periodismo económico regional</p>
    {# El H1 debe ser único por página: en la portada lo es el nombre del medio;
       en una noticia, el H1 es el titular, así que aquí baja a <p>. #}
    {% if page.url == "/" %}
    <h1><a href="/" style="color:inherit; text-decoration:none;">Economía <span class="leo">Santander</span></a></h1>
    {% else %}
    <p class="marca"><a href="/" style="color:inherit; text-decoration:none;">Economía <span class="leo">Santander</span></a></p>
    {% endif %}
    <p class="tagline">Inversión, empleo y desarrollo del oriente colombiano, con veinte años de reportería económica detrás de cada historia.</p>
  </div>
</header>

<nav class="primary">
  <div class="wrap">
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
      <span class="nav-burger" aria-hidden="true"></span>
      Menú
      <span class="nav-toggle-hint">Abrir</span>
    </button>
    <div class="nav-inner" id="nav-menu">
    <a href="/" {% if page.url == '/' %}class="current"{% endif %}>Portada</a>
    {# Las secciones temáticas cuelgan de un submenú: en el menú plano
       eran catorce enlaces y no se entendía la jerarquía del portal. #}
    <div class="nav-grupo" id="nav-grupo">
      <button type="button" class="nav-sub-toggle" id="nav-sub-toggle" aria-expanded="false" aria-controls="nav-secciones">
        Secciones<span class="nav-caret" aria-hidden="true"></span>
      </button>
      <div class="nav-sub" id="nav-secciones">
        {%- for s in collections.secciones %}
        <a href="/seccion/{{ s.nombre | slugify }}/">{{ s.nombre }}</a>
        {%- endfor %}
      </div>
    </div>
    <a href="/multimedia/" {% if page.url == '/multimedia/' %}class="current"{% endif %}>Multimedia</a>
    <a href="/dolar-hoy/" {% if page.url == '/dolar-hoy/' %}class="current"{% endif %}>Dólar hoy</a>
    <a href="/indicadores/" {% if page.url == '/indicadores/' %}class="current"{% endif %}>Indicadores</a>
    <a href="/quien-soy/" {% if page.url == '/quien-soy/' %}class="current"{% endif %}>Quién soy</a>
    </div>
  </div>
</nav>

{% if page.url == '/' %}
{# Anuncio superior de portada: contextual y compacto para no robar pantalla.
   El inventario vive en _data/anuncios.json y se edita en el CMS ("Publicidad"). #}
{% set anuncio = anuncios.anuncios | anuncioPara('Portada', 'portada-superior') %}
{% set anuncioCompacto = true %}
{% include "anuncio.njk" %}
{% set anuncio = null %}
{% set anuncioCompacto = false %}
{% endif %}

<main>
{{ content | safe }}
</main>

