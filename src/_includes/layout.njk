        {%- for ind in mercado.indicadores %}
        <a class="ticker-item{% if ind.vivo %} live{% endif %}{% if ind.vivo == 'usd' %} js-usd-item{% endif %}" href="/indicadores/#{{ ind.id }}" title="{{ ind.title }}{% if ind.vivo or ind.yahoo %} Toca para ver la gráfica.{% else %} Toca para ver el detalle.{% endif %}">
