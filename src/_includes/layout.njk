<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = title or "Economía Santander | Noticias de economía en Santander" %}
{% set pageDescription = description or "Noticias económicas de Santander, Colombia: inversión, empleo, construcción, agro e indicadores. Análisis y reportería con más de 20 años de experiencia." %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="https://economiasantander.com{{ page.url }}">
{# La marca, para la pestaña del navegador y para el resultado de Google. El
   portal no tenía ninguna: Google busca un icono declarado en la PORTADA o un
   /favicon.ico en la raíz, no encontraba nada y pintaba el globo gris.
   Se declaran tres a propósito: el .ico lleva 16, 32 y 48 px dentro (Google
   pide múltiplo de 48 y es lo que entienden hasta los navegadores viejos), el
   .svg es el que usan los navegadores modernos, y el de 180 px es el de la
   pantalla de inicio de iOS. Las direcciones no deben cambiar nunca: Google
   guarda la del icono y volver a rastrearla cuesta semanas. #}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Economía Santander" href="https://economiasantander.com/feed.xml">
{# Un borrador no sale en la portada, pero su URL sí es pública en cuanto llega
   a main. Se marca noindex para que no lo indexe nadie mientras esté sin
   aprobar; al quitar eleventyExcludeFromCollections vuelve a ser indexable. #}
{% if eleventyExcludeFromCollections %}
<meta name="robots" content="noindex, nofollow">
{% else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{% endif %}
<meta name="author" content="{{ autor or 'Francisco Javier Gómez' }}">
<meta name="theme-color" content="#0B6E3B" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0C130E" media="(prefers-color-scheme: dark)">
{# Las dos caras que se ven de entrada: el cuerpo del texto y los titulares.
   Se precargan porque el navegador no las descubre hasta haber leído todo el
   CSS, y con eso el texto tarda más en aparecer. Las otras dos (Barlow 600 y
   700) no se precargan a propósito: van más abajo y precargar de más compite
   por el ancho de banda con lo que sí urge.
   El nombre lleva huella, así que se pueden cachear un año sin miedo. #}
<link rel="preload" href="/assets/fonts/barlow-400.81419bf5ab.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/oswald-600.5f49329007.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ cssUrl }}">
<!-- Open Graph -->
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="Economía Santander">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="https://economiasantander.com{{ page.url }}">
<meta property="og:locale" content="es_CO">
{% set ogImagen = imagen or "/assets/uploads/empleo-formal-bucaramanga-area-metropolitana-2026.jpg" %}
{# Versión de 1200 px en JPEG en vez del original: hay fotos de 4,5 MB y
   WhatsApp no las descarga para la vista previa, así que el enlace salía sin
   foto. Las medidas se declaran de verdad, no quemadas en 1200x700. #}
{# Una ficha de multimedia puede traer como imagen social la miniatura que sirve
   el propio YouTube, que es una dirección completa y no un archivo del
   repositorio. A esa no se le puede pedir versión optimizada —los dos filtros
   buscan el archivo en disco— ni se le puede anteponer el dominio, o saldría
   "https://economiasantander.comhttps://i.ytimg.com/…". #}
{% set ogRemota = "//" in ogImagen %}
{% set ogPrevia = null if ogRemota else (ogImagen | imagenVistaPrevia) %}
{% set ogMedidas = null if ogRemota else (ogImagen | medidas) %}
{% set ogUrl = ogImagen if ogRemota else ("https://economiasantander.com" + (ogPrevia.url if ogPrevia else ogImagen)) %}
<meta property="og:image" content="{{ ogUrl }}">
{% if ogPrevia %}<meta property="og:image:width" content="{{ ogPrevia.width }}">
<meta property="og:image:height" content="{{ ogPrevia.height }}">
{% elif ogMedidas %}<meta property="og:image:width" content="{{ ogMedidas.width }}">
<meta property="og:image:height" content="{{ ogMedidas.height }}">{% endif %}
{% if imagenAlt %}<meta property="og:image:alt" content="{{ imagenAlt }}">{% endif %}
<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ ogUrl }}">
{# Aquí había un preload de la foto original. Con el plugin de imágenes es
   contraproducente: reescribe las <img> pero NO los <link rel=preload>, así que
   el navegador se bajaba el original completo (hasta 4,5 MB) ADEMÁS de la
   versión optimizada. La foto va alta en el HTML y lleva fetchpriority="high"
   en la propia etiqueta, que es lo que hace falta. #}
<!-- Analítica (Google Analytics 4).
     Encendida por defecto: en Colombia la Ley 1581 exige informar y permitir
     el rechazo, no pedir permiso previo para analítica propia. Quien rechaza
     en /legal/cookies/ queda registrado y a partir de ahí no se mide.
     La publicidad personalizada sigue denegada siempre. -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;

    var decision = null;
    try { decision = window.localStorage.getItem('es-consent-analitica'); } catch (e) {}

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: decision === 'no' ? 'denied' : 'granted'
    });

    window.esCargarAnalitica = function () {
      if (window.esAnaliticaCargada) return;
      window.esAnaliticaCargada = true;
      gtag('consent', 'update', { analytics_storage: 'granted' });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HVC4Z011SY';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-HVC4Z011SY', { anonymize_ip: true });

      // Ahrefs Web Analytics. No usa cookies, pero sí mide, así que se carga
      // con la misma decisión que Google Analytics: el aviso del sitio promete
      // que quien rechaza deja de ser medido, y esa promesa vale para las dos
      // herramientas, no solo para la que guarda cookies.
      var ah = document.createElement('script');
      ah.async = true;
      ah.src = 'https://analytics.ahrefs.com/analytics.js';
      ah.setAttribute('data-key', 'MF6QGETkI/zizIV3w3Je/A');
      document.head.appendChild(ah);
    };

    window.esApagarAnalitica = function () {
      gtag('consent', 'update', { analytics_storage: 'denied' });
    };

    if (decision !== 'no') window.esCargarAnalitica();
  })();
</script>

