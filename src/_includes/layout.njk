<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = title or "Economía Santander | Noticias de economía en Santander" %}
{% set pageDescription = description or "Noticias económicas de Santander, Colombia: inversión, empleo, construcción, agro e indicadores. Análisis y reportería con más de 20 años de experiencia." %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="https://economiasantander.com{{ page.url }}">
{# Un borrador no sale en la portada, pero su URL sí es pública en cuanto llega
   a main. Se marca noindex para que no lo indexe nadie mientras esté sin
   aprobar; al quitar eleventyExcludeFromCollections vuelve a ser indexable. #}
{% if eleventyExcludeFromCollections %}
<meta name="robots" content="noindex, nofollow">
{% else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{% endif %}
<meta name="author" content="{{ autor or 'Francisco Javier Gómez' }}">
<meta name="theme-color" content="#0B6E3B" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0C130E" media="(prefers-color-scheme: dark)">
<link rel="stylesheet" href="/assets/style.css">
<!-- Open Graph -->
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="Economía Santander">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="https://economiasantander.com{{ page.url }}">
<meta property="og:locale" content="es_CO">
{% set ogImagen = imagen or "/assets/uploads/empleo-formal-bucaramanga-area-metropolitana-2026.jpg" %}
<meta property="og:image" content="https://economiasantander.com{{ ogImagen }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="700">
{% if imagenAlt %}<meta property="og:image:alt" content="{{ imagenAlt }}">{% endif %}
<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="https://economiasantander.com{{ ogImagen }}">
{% if imagen %}<link rel="preload" as="image" href="{{ imagen }}" fetchpriority="high">{% endif %}
<!-- Analítica (Google Analytics 4).
     Encendida por defecto: en Colombia la Ley 1581 exige informar y permitir
     el rechazo, no pedir permiso previo para analítica propia. Quien rechaza
     en /legal/cookies/ queda registrado y a partir de ahí no se mide.
     La publicidad personalizada sigue denegada siempre. -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;

    var decision = null;
    try { decision = window.localStorage.getItem('es-consent-analitica'); } catch (e) {}

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: decision === 'no' ? 'denied' : 'granted'
    });

    window.esCargarAnalitica = function () {
      if (window.esAnaliticaCargada) return;
      window.esAnaliticaCargada = true;
      gtag('consent', 'update', { analytics_storage: 'granted' });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HVC4Z011SY';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-HVC4Z011SY', { anonymize_ip: true });
    };

    window.esApagarAnalitica = function () {
      gtag('consent', 'update', { analytics_storage: 'denied' });
    };

    if (decision !== 'no') window.esCargarAnalitica();
  })();
</script>

