{# Tarjeta de un contenido multimedia. Espera `item` (entrada de collections.multimedia).

   La tarjeta ya NO reproduce: lleva a la ficha del contenido, que desde ahora
   tiene dirección propia (/multimedia/<slug>/). Antes el video se reproducía
   dentro de la tarjeta y no había forma de enviarle a alguien ese video: no
   existía como página. De paso, la sección deja de cargar un reproductor por
   cada tarjeta. #}
{% set mmTipo = item.data.tipo or 'video' %}
{% set etiqueta = { video: 'Video', podcast: 'Podcast', galeria: 'Galería', foto: 'Foto', red: 'En redes' }[mmTipo] or mmTipo %}
{% set yid = item.data.youtube | ytId %}
{% set tapa = item.data.portada or (item.data.imagenes[0] if item.data.imagenes) or (("https://i.ytimg.com/vi/" + yid + "/hqdefault.jpg") if yid) %}
<article class="mm-card" id="mm-{{ item.fileSlug | slugify }}">
  <a class="mm-thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if tapa -%}
      {%- if "//" in tapa -%}
      {# Miniatura de YouTube. El build también se la baja y la sirve desde
         aquí, pero si un día compila sin red se queda apuntando al original:
         por eso lleva medidas declaradas (480x360 es el tamaño real de
         hqdefault) y no se queda sin relación de aspecto reservada. #}
      <img src="{{ tapa }}" alt="" loading="lazy" decoding="async" width="480" height="360">
      {%- else -%}
      <img src="{{ tapa }}" alt="" sizes="(max-width: 720px) 92vw, 300px" loading="lazy" decoding="async">
      {%- endif -%}
    {%- else -%}
      <span class="mm-sin-foto" aria-hidden="true">{{ etiqueta }}</span>
    {%- endif -%}
    {%- if mmTipo == 'video' or mmTipo == 'podcast' -%}<span class="mm-play-btn" aria-hidden="true"></span>{%- endif -%}
    {%- if mmTipo == 'galeria' and item.data.imagenes -%}<span class="mm-count">{{ item.data.imagenes | length }} fotos</span>{%- endif -%}
    <span class="mm-tipo mm-tipo-{{ mmTipo }}">{{ etiqueta }}</span>
  </a>
  <h3 class="mm-title"><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
  {% if item.data.descripcion %}<p class="mm-desc">{{ item.data.descripcion }}</p>{% endif %}
  {% if item.data.fuente %}<p class="mm-fuente">{{ item.data.fuente }}</p>{% endif %}
</article>
