---
layout: layout.njk
title: Economía Santander | Noticias de economía en Santander
ogType: website
---
{# Orden de la portada: primero lo fijado a mano en "Datos del sitio → Orden de
   la portada"; el resto, por fecha. Con la lista vacía manda la fecha. #}
{% set noticias = collections.noticias | ordenarPortada(portada.destacadas) %}
{% set hero = noticias[0] %}
{% set secundarias = noticias.slice(1, 5) %}

  {% if hero %}
  <section class="hero-section wrap">
    <div class="hero-grid">
      {% if hero.data.imagen %}
      <figure class="hero-figure">
        <img class="hero-art-img" src="{{ hero.data.imagen }}"
             width="1200" height="700"
             fetchpriority="high" decoding="async"
             alt="{{ hero.data.imagenAlt or hero.data.title }}"
             title="{{ hero.data.imagenTitle or hero.data.title }}">
        <figcaption class="hero-art-credit">{{ hero.data.imagenPie or hero.data.excerpt }} <span>{{ hero.data.imagenCredito or 'Foto: Economía Santander' }}</span></figcaption>
      </figure>
      {% else %}
      <div>
        <div class="hero-art" role="img" aria-label="Ilustración con los colores verde y amarillo, motivo de leopardo"></div>
        <p class="hero-art-credit">Imagen de referencia — pendiente la foto de la nota.</p>
      </div>
      {% endif %}
      <div>
        <div class="hero-eyebrow">
          <span class="tag">Portada · {{ hero.data.categoria }}</span>
          <span class="chip {{ hero.data.chipTipo or 'propio' }}">{{ hero.data.chipLabel or 'Redacción propia' }}</span>
        </div>
        <h2 class="hero-headline"><a href="{{ hero.url }}">{{ hero.data.title }}</a></h2>
        <p class="hero-dek">{{ hero.data.excerpt }}</p>
        <p class="byline">Por <b>{{ hero.data.autor or 'Francisco Javier Gómez' }}</b> · Actualizado el {{ hero.data.date | readableDate }}</p>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: 30px;">
    <div class="secondary-list">
      {% for n in secundarias %}
      <article class="secondary-item">
        <div class="secondary-eyebrow"><span class="tag">{{ n.data.categoria }}</span><span class="chip {{ n.data.chipTipo or 'propio' }}">{{ n.data.chipLabel or 'Propia' }}</span></div>
        <h3><a href="{{ n.url }}">{{ n.data.title }}</a></h3>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% set mm = collections.multimedia | reverse %}
  {% if mm.length %}
  <section class="section-block wrap mm-home" id="multimedia">
    <div class="section-head">
      <h2>Multimedia</h2>
      <span class="sub">Video, podcast, fotos y galerías · <a class="mm-ver-todo" href="/multimedia/">Ver toda la sección →</a></span>
    </div>
    <div class="mm-grid">
      {% for item in mm.slice(0, 3) %}
      {% include "mm-card.njk" %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# Anuncio intermedio de portada: distinto al superior, elegido del inventario #}
  {% set adSuperior = anuncios.anuncios | anuncioPara('Portada', 'portada-superior') %}
  {% set anuncio = anuncios.anuncios | anuncioPara('Portada', 'portada-media', adSuperior.id) %}
  {% set anuncioCompacto = false %}
  {% include "anuncio.njk" %}
  {% set anuncio = null %}

  {# Las tarjetas leen de la colección real: cada sección muestra sus dos
     notas más recientes y la que no tenga ninguna no se pinta. Antes eran
     catorce titulares escritos a mano que no llevaban a ningún lado. #}
  <section class="section-block wrap">
    <div class="section-head">
      <h2>Secciones principales</h2>
      <span class="sub">Los siete núcleos temáticos del portal</span>
    </div>
    <div class="core-grid">
      {% for s in secciones.principales %}
      {% set notasSec = collections.noticias | porCategoria(s.nombre, 2) %}
      {% if notasSec.length %}
      <div class="core-card">
        <h3><a href="/seccion/{{ s.nombre | slugify }}/">{{ s.nombre }}</a></h3>
        <p class="desc">{{ s.desc }}</p>
        <div class="headlines">
          {% for n in notasSec %}
          <div class="row">
            <span class="chip {{ n.data.chipTipo or 'propio' }}">{{ n.data.chipLabel or 'Propia' }}</span>
            <a href="{{ n.url }}">{{ n.data.title }}</a>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="section-block wrap">
    <div class="section-head">
      <h2>Además, en el portal</h2>
      <span class="sub">Secciones complementarias</span>
    </div>
    <div class="comp-row">
      {% for s in secciones.complementarias %}
      {% set cuantas = (collections.noticias | porCategoria(s.nombre)).length %}
      <a href="/seccion/{{ s.nombre | slugify }}/">{{ s.nombre }}{% if cuantas %} <b>{{ cuantas }}</b>{% endif %}</a>
      {% endfor %}
    </div>
  </section>

  <!-- Espacio publicitario: rectángulo. Ideal para patrocinio del bloque de tasas (bancos, fiduciarias, fintech). -->
  <div class="wrap ad-wrap">
    <div class="ad-slot ad-rectangle">
      <span class="ad-label">Espacio publicitario · patrocinio de sección</span>
      <span class="ad-size">Rectángulo · 300 × 250 o 336 × 280</span>
      <span class="ad-hint">Contexto financiero: bancos, fiduciarias, fintech y constructoras</span>
    </div>
  </div>

  <section class="section-block wrap" id="tasas">
    <div class="section-head">
      <h2>Tasas y rendimientos</h2>
      <span class="sub">Dónde rinde más tu plata y dónde el crédito cuesta menos · gira cada tarjeta para ver el listado</span>
    </div>

    <div class="tabs" role="tablist" aria-label="Tipo de tasa">
      <button type="button" class="tab-btn" role="tab" id="tab-cdt" aria-controls="panel-cdt" aria-selected="true">CDT</button>
      <button type="button" class="tab-btn" role="tab" id="tab-tarjeta" aria-controls="panel-tarjeta" aria-selected="false" tabindex="-1">Tarjeta de crédito</button>
      <button type="button" class="tab-btn" role="tab" id="tab-vivienda" aria-controls="panel-vivienda" aria-selected="false" tabindex="-1">Vivienda</button>
    </div>

    <!-- ===== CDT ===== -->
    <div class="tab-panel" id="panel-cdt" role="tabpanel" aria-labelledby="tab-cdt" tabindex="0">
      <div class="flip-grid">
        <div class="flip-card">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-term">90 días</span>
              <span class="flip-rate">hasta 11,90%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Banco Pichincha</span>
              <p class="flip-note">Corto plazo. Buena opción si necesitas el dinero disponible pronto.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver 6 entidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Tasas publicadas por las entidades, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Ranking · 90 días</span>
              <ul class="flip-list">
                <li>Banco Pichincha <b>11,90%</b></li>
                <li>Bold <b>11,20%</b></li>
                <li>Bancamía <b>10,35%</b></li>
                <li>Banca tradicional <b>de 9,00% a 11,00%</b></li>
                <li>Pibank <b>competitivo</b></li>
                <li>Lulo Bank <b>alta liquidez</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: tasas publicadas por cada entidad, recopiladas por LA FM, Noticias RCN y Rankia · julio de 2026. Bancamía a 3 meses, monto mínimo $50.000.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>

        <div class="flip-card">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-term">180 días</span>
              <span class="flip-rate">hasta 12,60%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Credifamilia</span>
              <p class="flip-note">Mediano plazo. Equilibrio entre rentabilidad y disponibilidad del dinero.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver 6 entidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Tasas publicadas por las entidades, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Ranking · 180 días</span>
              <ul class="flip-list">
                <li>Credifamilia <b>12,60%</b></li>
                <li>Banco Pichincha <b>11,90%</b></li>
                <li>KOA <b>11,55%</b></li>
                <li>Banco de Bogotá <b>más de 10,00%</b></li>
                <li>GNB Sudameris <b>más de 10,00%</b></li>
                <li>Bancoomeva <b>tasas premio</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: tasas publicadas por cada entidad, recopiladas por LA FM, Noticias RCN y Rankia · julio de 2026.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>

        <div class="flip-card best">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-badge">La más alta</span>
              <span class="flip-term">360 días o más</span>
              <span class="flip-rate">hasta 14,25%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Corficolombiana</span>
              <p class="flip-note">Con la inflación en 6,14%, deja un rendimiento real cercano a 8 puntos.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver 10 entidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Tasas publicadas por las entidades, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Ranking · 360 días o más</span>
              <ul class="flip-list">
                <li>Corficolombiana <b>14,25%</b></li>
                <li>KOA · 18 meses <b>13,51%</b></li>
                <li>Banco de Occidente <b>13,45%</b></li>
                <li>Mibanco <b>13,42%</b></li>
                <li>BBVA <b>13,31%</b></li>
                <li>Credifamilia · 18 meses <b>12,65%</b></li>
                <li>IRIS · 12 meses <b>12,50%</b></li>
                <li>Ban100 · 18 meses <b>12,50%</b></li>
                <li>KOA · 12 meses <b>12,40%</b></li>
                <li>Bancolombia <b>11,51%</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: tasas publicadas por cada entidad, recopiladas por LA FM, Noticias RCN, El Colombiano y Rankia · julio de 2026. Montos mínimos: KOA y Ban100 $250.000, IRIS $100.000, Credifamilia $1.000.000.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>
      </div>
      <p class="rate-disclaimer">Tasas efectivas anuales (E.A.) de referencia; cambian según entidad, monto y plazo, y siguen la tasa del Banco de la República (12,00%). Los intereses están sujetos a retención en la fuente del 4%. Confirma la tasa vigente en la entidad antes de invertir.</p>
    </div>

    <!-- ===== TARJETA DE CRÉDITO ===== -->
    <div class="tab-panel" id="panel-tarjeta" role="tabpanel" aria-labelledby="tab-tarjeta" tabindex="0" hidden>
      <div class="flip-grid">
        <div class="flip-card best">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-badge">La más baja</span>
              <span class="flip-term">Tasa más baja</span>
              <span class="flip-rate">desde 14,00%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Itaú Colombia</span>
              <p class="flip-note">Aquí la mejor tasa es la más baja: una de las menores del sistema financiero.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver 6 entidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Tarifas publicadas por las entidades, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Bancos con tasas más bajas</span>
              <ul class="flip-list">
                <li>Itaú Colombia <b>14,00%</b></li>
                <li>Banco Falabella <b>14,60%</b></li>
                <li>Banco Pichincha <b>14,90%</b></li>
                <li>Davivienda <b>según perfil</b></li>
                <li>AV Villas <b>según perfil</b></li>
                <li>Rango del mercado <b>de 18,37% a 28,77%</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: tarifas publicadas por cada entidad, recopiladas por La República, Infobae y LA FM · julio de 2026. La tasa aprobada depende de tu perfil de riesgo, el tipo de tarjeta y tu historial crediticio.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>

        <div class="flip-card">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-term">Promedio del mercado</span>
              <span class="flip-rate">19,19%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Interés bancario corriente</span>
              <p class="flip-note">El promedio que cobran los bancos. Si te ofrecen más, hay margen para negociar.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Qué significa →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Certificado por la Superintendencia Financiera, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Interés bancario corriente</span>
              <ul class="flip-list plain">
                <li>Lo certifica la <strong>Superintendencia Financiera</strong> cada mes.</li>
                <li>Se calcula con lo que reportan los bancos sobre crédito de consumo y ordinario.</li>
                <li>Para julio de 2026 quedó en <strong>19,19% E.A.</strong>, sin cambio frente a junio.</li>
                <li>De esta cifra sale el tope de usura: el interés corriente aumentado en la mitad.</li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente oficial: Superintendencia Financiera de Colombia, certificación vigente para julio de 2026.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>

        <div class="flip-card">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-term">Techo legal</span>
              <span class="flip-rate">28,79%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Tasa de usura</span>
              <p class="flip-note">Ninguna entidad puede cobrarte más en consumo y ordinario. Hacerlo es un delito.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver modalidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Certificada por la Superintendencia Financiera, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Usura por modalidad</span>
              <ul class="flip-list">
                <li>Consumo y ordinario <b>28,79%</b></li>
                <li>Consumo de bajo monto <b>62,10%</b></li>
                <li>Productivo de mayor monto <b>41,27%</b></li>
                <li>Productivo rural <b>32,75%</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente oficial: Superintendencia Financiera de Colombia, certificación vigente para julio de 2026. Si detectas un cobro por encima del tope, puedes denunciarlo ante la Superfinanciera.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>
      </div>
      <p class="rate-disclaimer">Tasas efectivas anuales de referencia para julio de 2026. La tasa que te aprueben depende de tu perfil crediticio, el producto y el monto.</p>
    </div>

    <!-- ===== VIVIENDA ===== -->
    <div class="tab-panel" id="panel-vivienda" role="tabpanel" aria-labelledby="tab-vivienda" tabindex="0" hidden>
      <div class="flip-grid">
        <div class="flip-card best">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-badge">La más barata</span>
              <span class="flip-term">Vivienda VIS</span>
              <span class="flip-rate">desde 10,79%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Fondo Nacional del Ahorro</span>
              <p class="flip-note">Vivienda de interés social. Hoy el FNA es quien presta más barato en este segmento.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver 6 entidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Superintendencia Financiera y tarifas de las entidades, 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Comparativo · vivienda VIS</span>
              <ul class="flip-list">
                <li>Fondo Nacional del Ahorro <b>10,79%</b></li>
                <li>Banagrario <b>11,85%</b></li>
                <li>Banco Caja Social <b>12,39%</b></li>
                <li>BBVA Colombia <b>12,59%</b></li>
                <li>Banco de Occidente <b>16,11%</b></li>
                <li>La Hipotecaria <b>16,45%</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: Superintendencia Financiera de Colombia y tarifas publicadas por cada entidad, recopiladas por Vivienda.com.co y Hepacom · 2026.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>

        <div class="flip-card">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-term">Vivienda No VIS</span>
              <span class="flip-rate">desde 10,00%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Bancos del Grupo Aval</span>
              <p class="flip-note">Promoción vigente desde el 10 de julio de 2026. El promedio del mercado ronda el 13%.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Ver 5 entidades →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Superintendencia Financiera y anuncios de las entidades, 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Comparativo · vivienda No VIS</span>
              <ul class="flip-list">
                <li>Banco de Bogotá <b>desde 10,00%</b></li>
                <li>Banco Popular <b>desde 10,00%</b></li>
                <li>AV Villas <b>desde 10,00%</b></li>
                <li>Banco de Occidente <b>desde 10,00%</b></li>
                <li>Promedio del mercado <b>cerca de 13,00%</b></li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: promedio de la Superintendencia Financiera (corte mayo de 2026) y anuncio del Grupo Aval del 10 de julio de 2026. En un crédito a 15 o 20 años, un punto de tasa son millones de pesos: pide al menos tres cotizaciones.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>

        <div class="flip-card">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <span class="flip-term">Leasing habitacional</span>
              <span class="flip-rate">desde 9,50%<i>E.A.<span class="flip-ast">*</span></i></span>
              <span class="flip-entity">Bancos del Grupo Aval</span>
              <p class="flip-note">La alternativa más barata hoy: el banco compra la vivienda y tú pagas un canon.</p>
              <button type="button" class="flip-btn" aria-expanded="false">Cómo funciona →</button>
              <p class="flip-source"><span class="flip-ast">*</span> Anuncio del Grupo Aval, julio de 2026.</p>
            </div>
            <div class="flip-face flip-back">
              <span class="flip-back-title">Leasing habitacional</span>
              <ul class="flip-list plain">
                <li>El banco es el dueño de la vivienda mientras tú pagas un canon mensual.</li>
                <li>Al final ejerces la opción de compra, normalmente entre el 1% y el 30% del valor.</li>
                <li>Puede financiar hasta el 100% del inmueble, más que un crédito tradicional.</li>
                <li>Tasas <strong>desde 9,50% E.A.</strong> en los bancos del Grupo Aval.</li>
              </ul>
              <p class="flip-source"><span class="flip-ast">*</span> Fuente: anuncio de los bancos del Grupo Aval (Bogotá, Popular, AV Villas y Occidente), vigente desde el 10 de julio de 2026.</p>
              <button type="button" class="flip-btn" aria-expanded="true">← Volver</button>
            </div>
          </div>
        </div>
      </div>
      <p class="rate-disclaimer">Tasas efectivas anuales de referencia para 2026. Las tasas en pesos y en UVR se comportan distinto: la UVR se ajusta con la inflación, hoy en 6,14%. Confirma condiciones, seguros y costos asociados con cada entidad.</p>
    </div>
  </section>

  {# El bloque de opinión sale de una columna real: sin columna publicada,
     no se pinta. Antes mostraba una cita atribuida al director que él
     nunca escribió. #}
  {% set columnas = collections.noticias | porCategoria('Opinión', 1) %}
  {% if columnas.length %}
  <section class="opinion-block">
    <div class="wrap opinion-inner">
      <span class="tag">Opinión · Más allá del dato</span>
      <p class="opinion-quote">{{ columnas[0].data.excerpt }}</p>
      <p class="opinion-attr">— <b>{{ columnas[0].data.autor or 'Francisco Gómez - Director' }}</b>, <a href="{{ columnas[0].url }}">{{ columnas[0].data.title }}</a></p>
      <a class="opinion-link" href="/seccion/opinion/">Ver todas las columnas →</a>
    </div>
  </section>
  {% endif %}

  {# Declaraciones REALES de los gremios, con su fuente enlazada. Viven en
     _data/declaraciones.json; si el archivo queda vacío, la sección no
     aparece. Nunca se inventa una cita. #}
  {% if declaraciones.citas.length %}
  <section class="section-block wrap">
    <div class="section-head">
      <h2>Lo que dicen los gremios</h2>
      <span class="sub">Declaraciones publicadas, con su fuente</span>
    </div>
    <div class="interview-grid">
      {% for d in declaraciones.citas %}
      <div class="interview-card">
        <p class="interview-org">{{ d.gremio }}</p>
        <p class="interview-cita">“{{ d.cita }}”</p>
        <p class="interview-quien">{{ d.persona }}<span>{{ d.cargo }}</span></p>
        <a class="interview-fuente" href="{{ d.url }}" target="_blank" rel="noopener">{{ d.medio }}, {{ d.fecha }} ↗</a>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% set guias = collections.noticias | soloGuias(4) %}
  {% if guias.length %}
  <section class="section-block wrap">
    <div class="evergreen-block">
      <div>
        <span class="tag">Contenido evergreen</span>
        <h2>Glosario y guías</h2>
        <p class="sub">Contenido de consulta permanente, para resolver dudas que se repiten todo el año.</p>
      </div>
      <div class="evergreen-list">
        {% for g in guias %}
        <a href="{{ g.url }}">{{ g.data.title }} <span class="arrow">→</span></a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  <!-- Espacio publicitario: banner de cierre, antes del pie de página. -->
  <div class="wrap ad-wrap">
    <div class="ad-slot ad-billboard">
      <span class="ad-label">Espacio publicitario</span>
      <span class="ad-size">Billboard de cierre · 970 × 250</span>
      <span class="ad-hint">Último impacto antes del pie de página</span>
    </div>
  </div>
